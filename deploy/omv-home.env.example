# Copy to /etc/omv-home.env and adjust. All values are optional.
# OMVHOME_LISTEN=:8080
# URL where OMV answers /rpc.php. Include the port if you changed it (e.g. http://127.0.0.1:81).
# The "advanced settings" link in the UI uses the same port.
# OMVHOME_OMV_URL=http://127.0.0.1
# OMVHOME_DATA_DIR=/var/lib/omv-home
# Put app data on a disk managed by OMV (recommended), e.g. a shared folder:
# OMVHOME_APPDATA_DIR=/srv/dev-disk-by-uuid-XXXX/appdata
# OMVHOME_PUID=1000
# OMVHOME_PGID=100
# OMVHOME_TZ=America/Sao_Paulo
# Optional extra app catalog (JSON array of template URLs):
# OMVHOME_CATALOG_URL=
